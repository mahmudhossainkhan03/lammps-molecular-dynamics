# -------------------------------------------------------------
# LAMMPS Input Script: ReaxFF Tensile Deformation of Guaiacyl Lignin Oligomer
# -------------------------------------------------------------

units           real
atom_style      charge
boundary        p p p

# --- Atomic Structure & ReaxFF Force Field ---
read_data       data.lignin
pair_style      reaxff NULL
pair_coeff      * * ffield.reax C H O

# --- Charge Equilibration (QEq) & Neighbor List ---
fix             1 all qeq/reaxff 1 0.0 10.0 1e-6 reaxff
neighbor        2.0 bin
neigh_modify    every 10 delay 0 check yes

# --- Thermo Output Setup ---
thermo          100
thermo_style    custom step temp pe ke etotal press pxx pyy pzz lx ly lz

# --- Equilibration Phase (NVT Ensemble at 300K) ---
velocity        all create 300.0 43210 mom yes rot yes dist gaussian
fix             2 all nvt temp 300.0 300.0 100.0
timestep        0.25
run             4000
unfix 2

# --- Uniaxial Tensile Deformation ---
reset_timestep  0
fix             2 all nvt temp 300.0 300.0 100.0
fix             3 all deform 1 z erate 0.0001 units box remap x

# --- Dump Atomic Positions & Charges for OVITO ---
dump            1 all custom 200 lignin_tensile.lammpstrj id type q x y z
dump_modify     1 sort id

# --- Execute Simulation ---
run             10000
